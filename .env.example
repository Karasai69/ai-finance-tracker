# Скопируйте этот файл в .env и впишите свои значения. Файл .env не попадает в git.

# База данных. По умолчанию — файл SQLite рядом с проектом.
# Для PostgreSQL (например, Neon) вставьте адрес вида postgresql://user:password@host/dbname
DATABASE_URL=sqlite:///./finance.db

# Секретный ключ для токенов входа. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# ИИ (необязательно). Без ключа работает простой разбор по ключевым словам.
# Подходит любой провайдер с OpenAI-совместимым API. Бесплатный вариант — Groq:
#   ключ: https://console.groq.com/keys
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
# Название модели из списка на https://console.groq.com/docs/models
AI_MODEL=openai/gpt-oss-20b
